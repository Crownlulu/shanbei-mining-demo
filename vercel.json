{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/v3",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v3/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}